#!/usr/bin/env python3
"""voice-say "текст" — озвучить текст голосом (Piper-модель, фонемы от espeak-ng)
и положить голосовое .ogg в outbox: после ответа бот пришлёт его в тему как
войс-сообщение. Работает локально, без сети и оплаты."""
import json, os, subprocess, sys, tempfile, time, unicodedata, wave

import numpy as np
import onnxruntime as ort

MODEL = os.environ.get("VOICE_MODEL", "/opt/voice/ru.onnx")
SPEED = float(os.environ.get("VOICE_SPEED", "0.85"))  # length_scale: меньше = быстрее


def main():
    text = " ".join(sys.argv[1:]).strip() if len(sys.argv) > 1 else sys.stdin.read().strip()
    out_dir = os.environ.get("INOAGENT_OUTBOX")
    if not text or not out_dir:
        sys.exit("usage: voice-say <текст> (нужен INOAGENT_OUTBOX)")
    cfg = json.load(open(MODEL + ".json"))
    ids_map = cfg["phoneme_id_map"]
    inf = cfg.get("inference", {})
    voice = cfg.get("espeak", {}).get("voice", "ru")
    sess = ort.InferenceSession(MODEL, providers=["CPUExecutionProvider"])
    has_sid = any(i.name == "sid" for i in sess.get_inputs())

    chunks = []
    for part in text.replace("\n", ". ").split(". "):
        part = part.strip()
        if part:
            chunks.append(part)
    audio = []
    gap = np.zeros(int(cfg["audio"]["sample_rate"] * 0.25), dtype=np.float32)
    for part in chunks:
        ph = subprocess.run(["espeak-ng", "-q", "--ipa", "-v", voice, part],
                            capture_output=True, text=True, check=True).stdout
        ph = unicodedata.normalize("NFD", " ".join(ph.split()))
        ids = list(ids_map["^"])
        for ch in ph:
            if ch in ids_map:
                ids += ids_map[ch] + ids_map["_"]
        ids += ids_map["$"]
        feed = {
            "input": np.array([ids], dtype=np.int64),
            "input_lengths": np.array([len(ids)], dtype=np.int64),
            "scales": np.array([inf.get("noise_scale", 0.667), inf.get("length_scale", 1.0) * SPEED,
                                inf.get("noise_w", 0.8)], dtype=np.float32),
        }
        if has_sid:
            feed["sid"] = np.array([0], dtype=np.int64)
        a = sess.run(None, feed)[0].squeeze().astype(np.float32)
        audio += [a, gap]
    pcm = np.concatenate(audio)
    pcm = (pcm / max(0.01, float(np.abs(pcm).max())) * 32767 * 0.9).astype(np.int16)
    with tempfile.TemporaryDirectory() as d:
        wav = os.path.join(d, "v.wav")
        with wave.open(wav, "wb") as w:
            w.setnchannels(1); w.setsampwidth(2); w.setframerate(cfg["audio"]["sample_rate"])
            w.writeframes(pcm.tobytes())
        dst = os.path.join(out_dir, "voice-%d.ogg" % int(time.time() * 1000))
        subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-i", wav, "-c:a", "libopus",
                        "-b:a", "32k", "-application", "voip", dst], check=True)
    print("отправлю голосовым:", os.path.basename(dst))


main()
