#!/bin/sh
# react <emoji> — put a reaction on the message you are answering, like a
# person would. The bot sets it right after the answer. Only Telegram's own
# reaction emoji work (👍 🔥 😁 🤣 🤔 👀 🫡 🗿 🤝 …). To react and say nothing,
# make your whole answer the single word NO_REPLY.
set -eu
[ -n "${INOAGENT_OUTBOX:-}" ] || { echo "react: нет INOAGENT_OUTBOX (запуск не от бота)" >&2; exit 1; }
[ $# -eq 1 ] || { echo "usage: react <emoji>" >&2; exit 2; }
printf '%s' "$1" > "$INOAGENT_OUTBOX/.react"
echo "поставлю реакцию $1"
