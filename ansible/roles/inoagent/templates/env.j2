# Rendered by ansible/roles/inoagent — edit host_vars, not this file.
TELEGRAM_BOT_TOKEN={{ inoagent_telegram_bot_token }}
TELEGRAM_CHAT_ID={{ inoagent_telegram_chat_id }}
TELEGRAM_APPROVER_IDS={{ inoagent_telegram_approver_ids | join(',') }}
INOAGENT_ALLOW_DM={{ inoagent_allow_dm | string | lower }}
INOAGENT_TRIGGER={{ inoagent_trigger }}
INOAGENT_APPROVAL_MODE={{ inoagent_approval_mode }}
INOAGENT_APPROVAL_TIMEOUT={{ inoagent_approval_timeout }}
INOAGENT_MAX_CONCURRENT={{ inoagent_max_concurrent }}
INOAGENT_DAILY_LIMIT={{ inoagent_daily_limit }}
INOAGENT_SESSION_IDLE={{ inoagent_session_idle }}
INOAGENT_RUN_TIMEOUT={{ inoagent_run_timeout }}
INOAGENT_MODEL={{ inoagent_model }}
INOAGENT_ASR_URL=http://127.0.0.1:9077
INOAGENT_ASR_MODEL={{ inoagent_asr_model }}
INOAGENT_ASR_LANGUAGE={{ inoagent_asr_language }}
CLAUDE_CODE_OAUTH_TOKEN={{ inoagent_claude_oauth_token }}
INOAGENT_REPO={{ inoagent_github_repo }}
INOAGENT_VAULT_REPO={{ inoagent_vault_repo }}
TZ={{ inoagent_timezone }}
{% for name, value in inoagent_extra_env.items() %}
{{ name }}={{ value }}
{% endfor %}
{% for name, value in inoagent_secret_env.items() %}
{{ name }}={{ value }}
{% endfor %}
# Scrubbed from everything the bot sends.
INOAGENT_SECRET_ENV={{ inoagent_secret_env.keys() | join(',') }}
